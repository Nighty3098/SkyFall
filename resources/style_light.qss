* {
    outline: none;
    font-size: 1rem;
    font-family: "Iosevka Charon Mono", monospace;
}

MainWindow, QWidget {
    background: #F5F5F5;
    color: #3A3A3A;
}

QWidget#centralwidget {
    border: none;
}

QAbstractScrollArea QWidget {
    background-color: transparent;
}

QWidget#metadataFileDropWidget {
    border-radius: 10px;
    border: 1px dashed #D0D0D0;
    background-color: #E8E8E8;
    color: #3A3A3A;
    padding: 5px;
}

QWidget#metadataFileDropWidget QLabel {
    background: transparent;
    color: #3A3A3A;
    font-size: 50px;
    font-style: italic;
}

tabWidget * {
    background: #F5F5F5;
    color: #3A3A3A;
}

QTabWidget {
    border: none;
}

QTabBar::tab {
    width: 150px;
    height: 30px;
    background: #E8E8E8;
    color: #888888;
    border: 1px solid #D0D0D0;
    border-radius: 10px;
    margin-bottom: 5px;
    margin-top: 5px;
    margin-left: 10px;
    margin-right: 10px;
}

QTabBar::tab:selected {
    color: #F5F5F5;
    background-color: #3A3A3A;
    border: 1px solid #3A3A3A;
    margin-bottom: 5px;
}

QTabBar::tab:hover:!selected {
    background-color: #D0D0D0;
    color: #3A3A3A;
}

QTabBar::scroller {
    width: 60px;
    background-color: transparent;
}

QTabBar QToolButton {
    background-color: #E8E8E8;
    border-radius: 4px;
    margin: 2px;
    color: #3A3A3A;
}

QTabBar QToolButton:hover {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

QTabBar QToolButton:pressed {
    background-color: #3A3A3A;
}

QTabBar::tear {
    background-color: #E8E8E8;
    width: 0px;
}

QListWidget#menuListWidget {
    background: transparent;
    border: none;
    outline: 0;
    margin: 0px;
    padding: 0px;
}

QListWidget#menuListWidget::item {
    width: auto;
    height: 20px;
    background: #E8E8E8;
    color: #888888;
    border-radius: 10px;
    padding-left: 15px;
}

QListWidget#menuListWidget::item:selected {
    color: #F5F5F5;
    background-color: #3A3A3A;
}

QListWidget#menuListWidget::item:hover:!selected {
    background-color: #D0D0D0;
    color: #3A3A3A;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    border-radius: 10px;
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
    color: #3A3A3A;
    padding: 5px;
    selection-background-color: #3A3A3A;
    selection-color: #F5F5F5;
}

QLineEdit {
    height: 20px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #3A3A3A;
}

QPushButton {
    border-radius: 10px;
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
    color: #3A3A3A;
    padding: 5px;
    height: 20px;
}

QPushButton:hover {
    background-color: #D0D0D0;
    color: #3A3A3A;
    border-color: #888888;
}

QPushButton:pressed {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

QDoubleSpinBox, QSpinBox, QComboBox, QDateTimeEdit {
    border-radius: 10px;
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
    color: #3A3A3A;
    padding: 5px;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button, QDateTimeEdit::up-button, QDateTimeEdit::down-button {
    border: none;
    border-radius: 5px;
    background: #D0D0D0;
    width: 15px;
    height: 15px;
    margin: 4px;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #888888;
}

QComboBox::drop-down, QDateTimeEdit::drop-down {
    border: none;
    border-radius: 5px;
    background: #D0D0D0;
    height: 20px;
    width: 20px;
    margin-right: 10px;
    margin-top: 5px;
}

QComboBox QAbstractItemView {
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
    color: #3A3A3A;
    selection-background-color: #3A3A3A;
    selection-color: #F5F5F5;
}

QCheckBox {
    margin-top: 5px;
    margin-bottom: 5px;
    padding-left: 1px;
    color: #3A3A3A;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
}

QCheckBox::indicator:unchecked:hover {
    border: 1px solid #888888;
}

QCheckBox::indicator:checked {
    background-color: #3A3A3A;
    border: 1px solid #3A3A3A;
}

QGroupBox {
    border: 1px solid #D0D0D0;
    border-radius: 10px;
    padding: 10px;
    margin-top: 0.5em;
    color: #3A3A3A;
}

QGroupBox::title {
    padding: 0 5px 0 5px;
    subcontrol-origin: margin;
    subcontrol-position: top center;
    left: 10px;
}

QGroupBox::flat {
    border-radius: 0px;
    border-left-style: none;
    border-right-style: none;
    border-bottom-style: none;
}

QProgressBar {
    color: #3A3A3A;
    background-color: #E8E8E8;
    border: 1px solid #D0D0D0;
    border-radius: 10px;
    outline: none;
    text-align: center;
    height: 30px;
}

QProgressBar::chunk {
    background-color: #3A3A3A;
    border-radius: 9px;
}

QListWidget {
    border-radius: 10px;
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
    color: #3A3A3A;
    padding: 5px;
}

QListWidget::item {
    border-radius: 5px;
    background-color: transparent;
    color: #3A3A3A;
    padding: 5px;
    margin: 2px;
}

QListWidget::item:hover {
    background-color: #D0D0D0;
}

QListWidget::item:selected {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

QLabel {
    color: #3A3A3A;
}

QLabel#metadataFilePath {
    border-radius: 10px;
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
    color: #888888;
    padding: 5px;
    height: 20px;
}

QLabel#appIconLabel {
    color: #3A3A3A;
}

QLabel#winTitle {
    color: #3A3A3A;
    font-size: 80px;
    font-style: italic;
    font-family: "Caveat", monospace;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #D0D0D0;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #888888;
}

QScrollBar::handle:vertical:pressed {
    background-color: #3A3A3A;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: transparent;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #D0D0D0;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #888888;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #3A3A3A;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: transparent;
    width: 0px;
}

GraphWidget, QGraphicsView {
    background-color: #F5F5F5;
    border: 1px solid #D0D0D0;
    border-radius: 10px;
    padding: 0px;
}

QMenuBar {
    color: #3A3A3A;
}

QMenuBar::item {
    background-color: transparent;
    border-radius: 8px;
    padding: 4px 12px;
    color: #3A3A3A;
}

QMenuBar::item:selected {
    background-color: #D0D0D0;
    color: #3A3A3A;
}

QMenuBar::item:pressed {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

QMenu {
    background-color: #E8E8E8;
    border: 1px solid #D0D0D0;
    padding: 4px;
    color: #3A3A3A;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 20px;
    margin: 2px 4px;
    border-radius: 6px;
    color: #D0D0D0;
}

QMenu::item:selected {
    background-color: #D0D0D0;
    color: #3A3A3A;
}

QMenu::separator {
    height: 1px;
    background: #D0D0D0;
    margin: 4px 8px;
}

NodeEditDialog {
    background-color: #F5F5F5;
    color: #3A3A3A;
    border: 1px solid #D0D0D0;
    border-radius: 10px;
}

NodeEditDialog QLabel {
    background: transparent;
    color: #3A3A3A;
    font-weight: bold;
}

NodeEditDialog QLineEdit,
NodeEditDialog QPlainTextEdit {
    border-radius: 10px;
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
    color: #3A3A3A;
    padding: 5px;
    selection-background-color: #3A3A3A;
    selection-color: #F5F5F5;
}

NodeEditDialog QLineEdit:focus,
NodeEditDialog QPlainTextEdit:focus {
    border: 1px solid #3A3A3A;
}

NodeEditDialog QPushButton {
    border-radius: 10px;
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
    color: #3A3A3A;
    padding: 6px 16px;
    min-height: 24px;
}

NodeEditDialog QPushButton:hover {
    background-color: #D0D0D0;
    color: #3A3A3A;
    border-color: #888888;
}

NodeEditDialog QPushButton:pressed {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

QPushButton#addNodeButton {
    border-radius: 10px;
    border: 1px solid #D0D0D0;
    background-color: #E8E8E8;
    color: #3A3A3A;
    padding: 5px;
    min-height: 30px;
}
QPushButton#addNodeButton:hover {
    background-color: #D0D0D0;
    border-color: #888888;
}
